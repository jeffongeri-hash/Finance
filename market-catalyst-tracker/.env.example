# Market Catalyst Tracker — Environment Variables
# Copy this file to .env and fill in values you have.
# The app works without any API keys using yfinance (Yahoo Finance) + free public APIs.
# You can also set these through the in-app Settings page (gear icon in sidebar).

# ── Optional: Finnhub (free tier: 60 calls/min) ───────────────────────────────
# Get a free key at: https://finnhub.io/register
# Enables: richer news sentiment, company peers, real-time quotes
FINNHUB_API_KEY=

# ── Optional: FRED (Federal Reserve Economic Data) ───────────────────────────
# Get a free key at: https://fred.stlouisfed.org/docs/api/api_key.html
# Enables: macro indicators overlay (CPI, Fed funds rate, yield curve, etc.)
FRED_API_KEY=

# ── Optional: Nasdaq Data Link ────────────────────────────────────────────────
# Get a free key at: https://data.nasdaq.com/account/profile
# Enables: FINRA short interest, EOD price history
NASDAQ_DATA_LINK_API_KEY=

# ── Polymarket Live Trading ───────────────────────────────────────────────────
# Required for live order execution on Polymarket CLOB.
# Without these the engine runs in paper mode silently.
POLY_PRIVATE_KEY=
POLY_FUNDER=
# POLY_HOST=https://clob.polymarket.com

# ── Equity AI (ai-hedge-fund — 19 analyst agents) ────────────────────────────
# Requires FINANCIAL_DATASETS_API_KEY + at least one LLM key.
FINANCIAL_DATASETS_API_KEY=

# LLM — provide ONE or more (Groq has a generous free tier)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Optional: override the default model (gpt-4o-mini via OpenAI)
# EQUITY_MODEL_NAME=gpt-4o-mini
# EQUITY_MODEL_PROVIDER=OpenAI

